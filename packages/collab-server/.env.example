# Collaboration Server Configuration
# Copy to .env and fill in your values

# ── JWT Authentication ─────────────────────────────────────────────────────────
COLLAB_JWT_SECRET=change-me-in-production-use-secrets-token-hex-32
COLLAB_JWT_EXPIRE_HOURS=168        # 7 days

# ── Initial Admin API Key ──────────────────────────────────────────────────────
# Set this to bootstrap the first admin user without a token endpoint
COLLAB_API_KEY=your-initial-admin-api-key

# ── Team Identity ──────────────────────────────────────────────────────────────
COLLAB_TEAM_ID=my-team

# ── Qdrant Vector DB ───────────────────────────────────────────────────────────
# Use URL for remote/Docker Qdrant, or leave blank for local file storage
COLLAB_QDRANT_URL=http://localhost:6333
COLLAB_QDRANT_KEY=
# Local storage path (used if COLLAB_QDRANT_URL not set or can't connect)
COLLAB_STORAGE_PATH=./collab_qdrant_storage

# ── Embedding Model ────────────────────────────────────────────────────────────
# Required for indexing/searching knowledge base
# Primary: OpenAI text-embedding-3-small (fast, accurate)
OPENAI_API_KEY=sk-...
# Fallback: HuggingFace BAAI/bge-small-en-v1.5 (offline, no API key needed)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser clients
COLLAB_ALLOW_ORIGINS=http://localhost:3000,vscode-webview://*

# ── Server Port ───────────────────────────────────────────────────────────────
COLLAB_PORT=8766
