{
  "name": "vibe4fpga",
  "displayName": "FPGA Vibe Coding",
  "description": "AI-assisted FPGA development powered by LLM + EDA toolchain integration",
  "version": "0.0.1",
  "publisher": "vibe4fpga",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "AI", "Other"],
  "keywords": ["FPGA", "Verilog", "SystemVerilog", "AI", "LLM", "EDA", "Vivado"],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibe4fpga.openChat",
        "title": "Open FPGA Chat",
        "category": "FPGA Vibe"
      },
      {
        "command": "vibe4fpga.spec2rtl",
        "title": "Spec → RTL",
        "category": "FPGA Vibe"
      },
      {
        "command": "vibe4fpga.codeReview",
        "title": "Code Review",
        "category": "FPGA Vibe"
      },
      {
        "command": "vibe4fpga.timingFix",
        "title": "Timing Fix",
        "category": "FPGA Vibe"
      },
      {
        "command": "vibe4fpga.waveformDebug",
        "title": "Waveform Debug",
        "category": "FPGA Vibe"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibe4fpga",
          "title": "FPGA Vibe Coding",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "vibe4fpga": [
        {
          "type": "webview",
          "id": "vibe4fpga.chatPanel",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "vibe4fpga.waveformPanel",
          "name": "Waveform"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "vibe4fpga.spec2rtl",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "vibe4fpga@1"
        },
        {
          "command": "vibe4fpga.codeReview",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "vibe4fpga@2"
        }
      ]
    },
    "configuration": {
      "title": "FPGA Vibe Coding",
      "properties": {
        "vibe4fpga.llm.backend": {
          "type": "string",
          "enum": ["claude", "openai", "gemini", "ollama", "deepseek", "rtlcoder"],
          "default": "claude",
          "description": "LLM backend for code generation and analysis"
        },
        "vibe4fpga.llm.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API key for the selected LLM backend. Store securely via OS keychain when possible."
        },
        "vibe4fpga.llmRouter.url": {
          "type": "string",
          "default": "http://localhost:8765",
          "description": "URL of the LLM Router sidecar service"
        },
        "vibe4fpga.vivado.path": {
          "type": "string",
          "default": "",
          "description": "Path to Vivado installation directory (e.g. /tools/Xilinx/Vivado/2024.1)"
        },
        "vibe4fpga.rag.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable RAG knowledge base (requires datasheet-mcp to be running)"
        },
        "vibe4fpga.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the vibe4fpga monorepo root. Used to locate MCP server packages. Defaults to the first workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.x",
    "@typescript-eslint/eslint-plugin": "^7.x",
    "@typescript-eslint/parser": "^7.x",
    "eslint": "^8.x",
    "typescript": "^5.x",
    "@vscode/test-electron": "^2.4.0",
    "mocha": "^10.6.0",
    "@types/mocha": "^10.0.6",
    "glob": "^11.0.0"
  },
  "dependencies": {}
}
