{
  "_comment": "Claude Code MCP servers snippet — merge into ~/.claude.json (or %USERPROFILE%\\.claude.json on Windows). Generated by tools/gen-skills/generate.py.",
  "mcpServers": {
{%- for mcp in mcps %}
    "{{ mcp.mcp_name }}": {
      "command": "{{ mcp.binary }}"{% if mcp.env and mcp.env.required %},
      "env": {
{%- for v in mcp.env.required %}
        "{{ v }}": "${env:{{ v }}}"{% if not loop.last %},{% endif %}
{%- endfor %}
      }
{%- endif %}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
