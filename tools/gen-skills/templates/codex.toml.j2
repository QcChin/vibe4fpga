# Codex CLI MCP config — append to ~/.codex/config.toml (or %USERPROFILE%\.codex\config.toml on Windows)
# Generated by tools/gen-skills/generate.py — do not hand-edit.

{% for mcp in mcps -%}
[mcp_servers.{{ mcp.mcp_name }}]
command = "{{ mcp.binary }}"
{%- if mcp.env and mcp.env.optional %}
# Optional env vars: {{ mcp.env.optional | join(", ") }}
{%- endif %}
{%- if mcp.env and mcp.env.required %}
env = { {% for v in mcp.env.required %}{{ v }} = "${{ '{' }}{{ v }}{{ '}' }}"{% if not loop.last %}, {% endif %}{% endfor %} }
{%- endif %}

{% endfor %}
